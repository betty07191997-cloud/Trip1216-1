<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#273043"><title>東京 7天6夜｜2026/12/16–12/22</title><style>
:root{--bg:#f5f0e9;--card:#fffdf9;--ink:#252a38;--muted:#707789;--line:#e5ddd3;--accent:#6f6079;--soft:#eee8f0;--warm:#c78c72}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Noto Sans TC","PingFang TC",sans-serif;padding-bottom:82px}.app{max-width:720px;margin:auto;min-height:100vh;background:var(--bg)}header{color:#fff;padding:30px 18px 22px;background:linear-gradient(145deg,#252b3b,#74657d);border-radius:0 0 28px 28px}.kicker{font-size:11px;letter-spacing:.12em;opacity:.8}h1{font-size:28px;margin:6px 0}.sub{font-size:13px;opacity:.9}.pills{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}.pill{font-size:12px;padding:7px 10px;border:1px solid #ffffff30;border-radius:999px;background:#ffffff18}main{padding:14px}.panel{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:16px;margin-bottom:12px;box-shadow:0 8px 24px #3d302510}.title{font-size:17px;font-weight:800;margin-bottom:10px}.days{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.day{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:14px;padding:8px 4px;min-height:54px}.day.active{background:var(--soft);border-color:var(--accent);font-weight:800}.day b,.day span{display:block}.day b{font-size:14px}.day span{font-size:11px;color:var(--muted)}.event{display:grid;grid-template-columns:78px 1fr;gap:10px;padding:11px 0;border-bottom:1px dashed var(--line)}.event:last-child{border-bottom:0}.time{font-size:13px;font-weight:800;color:var(--accent)}.et{font-size:14px;font-weight:750;line-height:1.4}.note,.small{font-size:12px;color:var(--muted);line-height:1.55;margin-top:3px}.notice{margin-top:12px;padding:12px;border-left:4px solid var(--warm);border-radius:12px;background:#c78c7215;font-size:13px;line-height:1.55}.row{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;padding:11px 0;border-bottom:1px solid var(--line)}.row:last-child{border:0}.map{display:inline-block;padding:9px 11px;background:var(--soft);border-radius:11px;color:var(--ink);text-decoration:none;font-size:12px;font-weight:750;white-space:nowrap}.nav{position:fixed;z-index:10;bottom:0;left:0;right:0;background:#fffdf9ed;border-top:1px solid var(--line);backdrop-filter:blur(14px);padding:7px 8px calc(7px + env(safe-area-inset-bottom))}.navin{max-width:720px;margin:auto;display:grid;grid-template-columns:repeat(5,1fr);gap:4px}.nav button{border:0;background:transparent;color:var(--muted);border-radius:12px;min-height:52px;font-size:11px}.nav button.active{color:var(--accent);background:var(--soft);font-weight:800}.ico{font-size:18px;display:block}.check{display:flex;gap:10px;padding:11px 0;border-bottom:1px solid var(--line);font-size:14px}.check input{width:20px;height:20px;accent-color:var(--accent)}@media(min-width:600px){.days{grid-template-columns:repeat(7,1fr)}}
</style></head><body><div class="app"><header><div class="kicker">TOKYO WINTER TRIP · 2026</div><h1>東京 7天6夜</h1><div class="sub">2026/12/16（三）～12/22（二）｜我＋妹妹</div><div class="pills"><span class="pill">⛰️ 高尾山硬目標</span><span class="pill">⛩️ 神社巡禮</span><span class="pill">💇 柏燙髮</span><span class="pill">♨️ 溫泉</span></div></header><main id="main"></main></div><nav class="nav"><div class="navin"><button data-tab="days" class="active"><span class="ico">📅</span>每日行程</button><button data-tab="transport"><span class="ico">🚆</span>交通</button><button data-tab="hotel"><span class="ico">🏨</span>住宿</button><button data-tab="packing"><span class="ico">🧳</span>行李</button><button data-tab="budget"><span class="ico">💴</span>預算</button></div></nav><script>
const D=[
['12/16','三','抵達東京｜池袋入住',[['14:25','✈️ 酷航 TR874 起飛',''],['約18:30','抵達成田機場 NRT T1',''],['19:15–20:30','機場 → 池袋 → 飯店','Skyliner＋JR 為優先考量；若抵達後疲累可依現場狀況改機場巴士。'],['20:30–21:30','池袋附近晚餐','第一晚不排景點。'],['21:30+','回飯店休息','']],[['東横INN東京池袋北口2号店','住宿']]],
['12/17','四','上野昇龍守 → 押上 → 池袋',[['08:30','飯店出發',''],['09:00–10:00','⛩️ 上野東照宮｜購買昇龍守','16～18日限定，建議開門後盡早到；數量可能售罄。'],['10:00–11:00','上野公園散步',''],['11:00–12:00','上野午餐',''],['12:00–13:00','上野 → 飛木稲荷神社',''],['13:00–13:40','🦊 飛木稲荷神社',''],['13:40–14:20','→ 白鬚神社',''],['14:20–15:00','⛩️ 白鬚神社',''],['15:00–16:00','→ 池袋',''],['16:00–17:00','🎬 AniBirth 池袋PARCO／東映動畫周邊',''],['17:00+','池袋晚餐＋自由活動','']],[['上野東照宮','景點'],['飛木稲荷神社 東京','景點'],['白鬚神社 東京 墨田区','景點'],['AniBirth 池袋PARCO','景點']]],
['12/18','五','高尾山＋極樂湯',[['07:00','飯店出發',''],['約08:15','抵達高尾山口',''],['08:15–08:45','整理、買水、廁所',''],['08:45–12:00','⛰️ 1號路上山 → 藥王院 → 山頂','妹妹若腿況不好，可改纜車上／下。'],['12:00–13:00','山上午餐＋休息',''],['13:00–15:00','下山','預設步行；疲勞時改纜車。'],['15:00–17:00','♨️ 京王高尾山溫泉 極樂湯','泡湯＋休息。'],['17:00–18:30','高尾山口 → 池袋',''],['19:00+','池袋晚餐','']],[['高尾山','景點'],['京王高尾山温泉 極楽湯','溫泉']]],
['12/19','六','金吾龍神社＋法輪寺＋柏燙髮',[['08:00 左右','池袋 → 代代木／新宿方向',''],['預約時段','🐉 金吾龍神社','完全預約制；兩人需要各自預約。建議盡量安排早上。一般參拜約¥500，御朱印／御守另計。'],['約10:00','→ 早稻田法輪寺',''],['10:00–10:45','⛩️ 法輪寺','硬目標，建議上午完成。'],['10:45–12:00','早稻田 → 柏',''],['12:00–12:30','柏站附近快速午餐',''],['12:30–17:30','💇 GDS SALON 柏｜燙髮約5小時','官方營業至18:00；實際預約時段需店家確認，避免超時。'],['17:30–19:00','柏 → 池袋',''],['19:00+','晚餐／休息','']],[['金吾龍神社 東京','景點'],['法輪寺 早稲田 東京','景點'],['GDS SALON 柏','髮廊']]],
['12/20','日','田無＋阿佐谷＋妙義',[['08:30','飯店出發',''],['09:30–10:30','⛩️ 田無神社',''],['10:30–11:30','田無 → 阿佐谷',''],['11:30–12:30','⛩️ 阿佐谷神明宮',''],['12:30–13:30','阿佐谷午餐',''],['13:30–14:30','→ 妙義神社',''],['14:30–15:30','⛩️ 妙義神社',''],['15:30+','回池袋，自由活動','']],[['田無神社 東京','景點'],['阿佐谷神明宮','景點'],['妙義神社 駒込 東京','景點']]],
['12/21','一','購物／休息／高尾山備援',[['09:30','悠閒早餐',''],['10:30–13:00','🛍️ 池袋購物／補貨','MUJI／UNIQLO／藥妝／唐吉訶德；購物預算另計。'],['13:00–14:00','午餐',''],['14:00+','自由時間、整理行李','']],[['MUJI 池袋','購物'],['UNIQLO 池袋','購物'],['唐吉訶德 池袋東口駅前店','購物']]],
['12/22','二','最後採買 → 成田 → 回台',[['07:00–09:00','早餐／整理行李',''],['10:00','退房、寄放行李',''],['10:00–14:00','最後採買／補漏景點',''],['14:00–15:00','回飯店拿行李＋最後一餐',''],['15:00–16:00','池袋 → 成田機場',''],['約17:00','抵達 NRT T1','預留報到、安檢、免稅／退稅時間。'],['22:05','✈️ Peach MM627 起飛','安全優先，不為了多逛一站而壓縮機場時間。']],[]]
];
const M=q=>'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(q);let sel=0;
function days(){const d=D[sel];main.innerHTML=`<section class="panel"><div class="title">每日行程</div><div class="days">${D.map((x,i)=>`<button class="day ${i===sel?'active':''}" onclick="sel=${i};days()"><b>${x[0]}</b><span>${x[1]}｜${x[2].split('｜')[0]}</span></button>`).join('')}</div></section><section class="panel"><div class="title">${d[0]}｜${d[2]}</div>${d[3].map(e=>`<div class="event"><div class="time">${e[0]}</div><div><div class="et">${e[1]}</div>${e[2]?`<div class="note">${e[2]}</div>`:''}</div></div>`).join('')}</section><section class="panel"><div class="title">📍 地點快速導航</div>${d[4].length?d[4].map(s=>`<div class="row"><div><b>${s[0]}</b><div class="small">${s[1]}</div></div><a class="map" href="${M(s[0])}" target="_blank" rel="noopener">開 Google Maps ↗</a></div>`).join(''):'<div class="small">今天沒有固定景點，保留時間給最後採買與返程。</div>'}</section>${sel===2?'<div class="notice">🌧️ 高尾山遇到不安全雨勢、強風或山況就不要硬上；移到 12/21。</div>':''}${sel===3?'<div class="notice">⚠️ 12/19 是整趟最需要守時間的一天：金吾龍神社完全預約制；GDS 營業至18:00，燙髮約5小時務必先確認預約時段。</div>':''}`}
function transport(){main.innerHTML='<section class="panel"><div class="title">🚆 交通策略</div><div class="notice">以 IC 卡單程支付為主；只有實際計算後更省才買交通券。</div><div class="row"><div><b>成田 → 池袋</b><div class="small">Skyliner＋JR 優先考量。</div></div><a class="map" href="'+M('東横INN東京池袋北口2号店')+'" target="_blank">飯店 ↗</a></div><div class="row"><div><b>池袋 ↔ 高尾山口</b><div class="small">整段預留約1h10–1h20。</div></div><a class="map" href="'+M('高尾山口駅')+'" target="_blank">導航 ↗</a></div><div class="row"><div><b>池袋 ↔ 柏</b><div class="small">JR 為主，約45–55分鐘。</div></div><a class="map" href="'+M('柏駅')+'" target="_blank">導航 ↗</a></div><div class="row"><div><b>池袋 → 成田</b><div class="small">回程安全優先，提早出發。</div></div><a class="map" href="'+M('成田国際空港 第1ターミナル')+'" target="_blank">機場 ↗</a></div></section>'}
function hotel(){main.innerHTML='<section class="panel"><div class="title">🏨 住宿</div><h2>東横INN東京池袋北口2號店</h2><div class="small">東京都豊島区池袋2-51-2｜〒171-0014</div><a class="map" href="'+M('東横INN東京池袋北口2号店')+'" target="_blank">📍 Google Maps / 導航 ↗</a><div class="row"><b>入住</b><span>15:00</span></div><div class="row"><b>退房</b><span>10:00</span></div><div class="row"><b>早餐</b><span>約06:30–09:00</span></div></section><section class="panel"><div class="title">📌 住宿策略</div><div class="small">全程固定池袋住宿，降低搬行李成本。12/22 退房後寄放行李，再取行李前往成田。</div></section>'}
function packing(){let a=['護照／機票資料','兩人 eSIM','日幣／IC 卡','旅平險','金吾龍神社：兩人各自完成預約','GDS：確認12/19燙髮時段','確認12/17昇龍守資訊','Visit Japan Web','充電器／行動電源','高尾山鞋子／外套／雨具','常用藥物','退稅購物用護照'];let s=JSON.parse(localStorage.getItem('tokyoPacking')||'[]');main.innerHTML='<section class="panel"><div class="title">🧳 出發前 Checklist</div>'+a.map((x,i)=>`<label class="check"><input type="checkbox" data-p="${i}" ${s.includes(i)?'checked':''}>${x}</label>`).join('')+'</section>';document.querySelectorAll('[data-p]').forEach(c=>c.onchange=()=>localStorage.setItem('tokyoPacking',JSON.stringify([...document.querySelectorAll('[data-p]:checked')].map(x=>+x.dataset.p))))}
function budget(){main.innerHTML='<section class="panel"><div class="title">💴 預算</div><div class="row"><b>每人上限</b><b>NT$20,000</b></div><div class="row"><b>兩人合計</b><b>NT$40,000</b></div><div class="small">包含交通、餐飲、景點門票、溫泉；不含機票、住宿、GDS 髮廊、購物／伴手禮。</div></section><section class="panel"><div class="title">💡 花費原則</div><div class="row"><b>餐飲</b><span>¥1,000–3,000／人／餐</span></div><div class="row"><b>交通</b><span>IC 卡為主</span></div><div class="row"><b>購物</b><span>獨立預算</span></div></section>'}
function tab(t){document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===t));({days,transport,hotel,packing,budget}[t])();scrollTo({top:0,behavior:'smooth'})}document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>tab(b.dataset.tab));days();
</script></body></html>
